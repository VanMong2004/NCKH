APP_NAME="CTUT UniShop"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://IP_VPS
FRONTEND_URL=http://IP_VPS

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=nckh
DB_USERNAME=ctut_user
DB_PASSWORD=CHANGE_ME_DB_PASSWORD
MYSQL_ROOT_PASSWORD=CHANGE_ME_ROOT_PASSWORD

CACHE_DRIVER=file
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database
SESSION_DRIVER=file
SESSION_LIFETIME=120
ORDER_AUTO_CANCEL_MINUTES=15

MAIL_MAILER=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="no-reply@ctut-unishop.local"
MAIL_FROM_NAME="${APP_NAME}"

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_VECTOR_STORE_ID=
OPENAI_CHAT_MAX_HISTORY=12
OPENAI_CHAT_SUMMARY_THRESHOLD=30
OPENAI_CHAT_SESSION_EXPIRE_DAYS=1

N8N_WEBHOOK_URL=http://n8n:5678/webhook/order-paid
N8N_WEBHOOK_SECRET=

N8N_AI_SYNC_SECRET=
N8N_AI_SYNC_LIMIT=20

N8N_SOCIAL_ENABLED=true
N8N_SOCIAL_WEBHOOK_URL=http://n8n:5678/webhook/ctut-product-social
N8N_SOCIAL_WEBHOOK_SECRET=
N8N_SOCIAL_CALLBACK_SECRET=
N8N_SOCIAL_PUBLIC_URL=http://IP_VPS

N8N_HOST=IP_VPS
N8N_PROTOCOL=http
N8N_WEBHOOK_PUBLIC_URL=http://IP_VPS:5678/
N8N_EDITOR_BASE_URL=http://IP_VPS:5678/
N8N_ENCRYPTION_KEY=CHANGE_ME_RANDOM_32_CHARS

FACEBOOK_GRAPH_VERSION=v25.0
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_ACCESS_TOKEN=

BROADCAST_DRIVER=pusher

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=ap1
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https

VITE_APP_NAME="${APP_NAME}"
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
