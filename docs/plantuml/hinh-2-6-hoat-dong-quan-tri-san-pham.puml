@startuml
title Hình 2.6. Sơ đồ hoạt động quản trị sản phẩm

skinparam shadowing false
skinparam defaultFontName Arial

start
:Quản trị viên đăng nhập;
:Truy cập khu vực quản lý sản phẩm;
:Chọn thêm mới hoặc chỉnh sửa sản phẩm;
:Nhập thông tin sản phẩm;
:Chọn danh mục và khoa/bộ phận;
:Upload ảnh sản phẩm;
:Thêm hoặc cập nhật biến thể;
:Nhập size, màu, SKU, giá, tồn kho;
:Kiểm tra dữ liệu đầu vào;

if (Dữ liệu hợp lệ?) then (Có)
    :Lưu sản phẩm;
    :Lưu ảnh sản phẩm;
    :Lưu biến thể sản phẩm;
    :Xóa cache/dữ liệu liên quan nếu có;
    :Hiển thị thông báo thành công;
else (Không)
    :Trả lỗi validation;
    :Hiển thị thông báo lỗi;
endif

stop

@enduml
